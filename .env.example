# 复制这个文件并改名为 .env，再填入你的 Key：
#   copy .env.example .env   （Windows）
#   cp .env.example .env     （macOS / Linux）

# ===== 多模型配置（配置当前使用的那一家即可）=====
# 当前使用的模型服务商：deepseek（默认）/ qwen（通义千问）/ doubao（豆包）
MODEL_PROVIDER=deepseek

# 可选：覆盖默认模型名。豆包建议填自己的模型名或接入点 ID（ep-xxx）
# MODEL_NAME=

# 是否开启 JSON 模式（默认开启，设成 0 关闭）
# MODEL_JSON_MODE=1

# DeepSeek：https://platform.deepseek.com 创建
DEEPSEEK_API_KEY=sk-your-key-here

# 通义千问：https://bailian.console.aliyun.com 创建（DashScope API Key）
# DASHSCOPE_API_KEY=sk-your-qwen-key

# 豆包：https://console.volcengine.com/ark 创建
# ARK_API_KEY=your-ark-key
